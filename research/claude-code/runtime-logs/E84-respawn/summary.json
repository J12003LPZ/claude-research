    "status": "idle"
  },
  "stop_exit": 0,
  "respawn_exit": 0,
  "respawn_output_nonempty": true,
  "after_respawn": {
    "kind": "background",
    "state": "working",
    "status": "idle"
  },
  "cleanup": {
    "stop_sent": true,
    "rm_sent": true,
    "after_cleanup_count": 0
  },
  "ids_withheld": true,
  "limits": [
    "The respawned session remained idle and no model turn completed",
    "No spare PTY or worker respawn was exercised"
  ]
}
